# v1 has no authentication and no email, so there are no auth or mail keys.
# Identity comes from a fixed seeded user via src/lib/current-user.ts.

# Neon pooled connection string. Required.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Bearer token from hardcover.app Settings, without the "Bearer " prefix.
# Only needed for live search. All provider tests are MSW-mocked.
HARDCOVER_API_TOKEN=

# Optional. Raises Google Books' request quota well above the low
# unauthenticated default. Get one free at console.cloud.google.com:
# enable the "Books API", then Credentials -> Create Credentials -> API key.
# The adapter works without it, just against a much smaller daily quota.
GOOGLE_BOOKS_API_KEY=

# Unset disables the deployment gate. Set this for Production and
# Preview in Vercel (and Development if used) before sharing the URL.
SITE_GATE_SECRET=

# Shared secret the GitHub Actions cron presents as an Authorization: Bearer
# header to POST /api/refresh. Unset refuses every request rather than
# running unauthenticated. Set this in Vercel for Production and Preview,
# and as a GitHub Actions repository secret.
CRON_SECRET=

# Web push VAPID keys. Generate with: npx web-push generate-vapid-keys
# Required for web push notifications in Production and Preview.
# Unset disables push; the app degrades gracefully.
# Set these three in Vercel (as secrets).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
