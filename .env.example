# v1 has no authentication and no email, so there are no auth or mail keys.
# Identity comes from a fixed seeded user via src/lib/current-user.ts.

# Neon pooled connection string. Required.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Bearer token from hardcover.app Settings, without the "Bearer " prefix.
# Only needed for live search. All provider tests are MSW-mocked.
HARDCOVER_API_TOKEN=

# Optional. Raises Google Books' request quota well above the low
# unauthenticated default. Get one free at console.cloud.google.com:
# enable the "Books API", then Credentials -> Create Credentials -> API key.
# The adapter works without it, just against a much smaller daily quota.
GOOGLE_BOOKS_API_KEY=
